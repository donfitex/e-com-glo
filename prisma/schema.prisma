generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 CUSTOMER
 ADMIN
}
enum OrderStatus {
 PENDING
 CONFIRMED
 SHIPPED
 DELIVERED
 CANCELLED
}
enum PaymentStatus {
 UNPAID
 PAID
 EXPIRED
 REFUND_REQUIRED
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 name String
 passwordHash String
 role Role @default(CUSTOMER)
 createdAt DateTime @default(now())
 cart Cart?
 orders Order[]
 wishlist WishlistItem[]
 inboxKey CustomerInboxKey?
 conversations Conversation[]
 broadcastReceipts BroadcastReceipt[]
 preferences CustomerPreferences?
 addresses SavedAddress[]
}
model Category {
 id String @id @default(uuid()) @db.Uuid
 name String
 slug String @unique
 products Product[]
}
model Product {
 id String @id @default(uuid()) @db.Uuid
 sku String @unique
 name String
 description String
 price Int
 currency String @db.VarChar(3)
 stock Int @default(0)
 active Boolean @default(true)
 attributes Json @default("{}")
 categoryId String @db.Uuid
 category Category @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 cartItems CartItem[]
 wishlist WishlistItem[]
 @@index([categoryId,active,createdAt,id])
 @@index([currency,active,price,id])
}
model Cart {
 id String @id @default(uuid()) @db.Uuid
 userId String @unique @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 items CartItem[]
}
model CartItem {
 cartId String @db.Uuid
 productId String @db.Uuid
 quantity Int
 cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 @@id([cartId,productId])
 @@index([productId])
}
model Order {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 status OrderStatus @default(PENDING)
 currency String @db.VarChar(3)
 total Int
 subtotal Int @default(0)
 shipping Int @default(0)
 tax Int @default(0)
 ruleVersion String @default("legacy")
 paymentStatus PaymentStatus @default(UNPAID)
 paymentReference String? @unique
 paymentAuthorizationUrl String?
 paymentProvider String?
 providerTransactionId String?
 expiresAt DateTime @default(dbgenerated("now() + interval '60 minutes'"))
 deliveryMinDays Int @default(3)
 deliveryMaxDays Int @default(7)
 paidAt DateTime?
 shippedAt DateTime?
 deliveredAt DateTime?
 estimatedDeliveryFrom DateTime?
 estimatedDeliveryTo DateTime?
 carrier String?
 trackingNumber String?
 trackingUrl String?
 shippingAddress Json
 idempotencyKey String @db.VarChar(100)
 createdAt DateTime @default(now())
 events OutboxEvent[]
 workItem OrderWorkItem?
 items OrderItem[]
 @@unique([userId,idempotencyKey])
 @@index([userId,createdAt,id])
 @@index([status,createdAt,id])
 @@index([status,paymentStatus,expiresAt])
}
model OrderItem {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
 productId String @db.Uuid
 sku String
 name String
 price Int
 quantity Int
 @@index([orderId])
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 actorId String? @db.Uuid
 action String
 entityId String?
 metadata Json @default("{}")
 createdAt DateTime @default(now())
 @@index([createdAt])
}

model PaymentEvent {
 id String @id
 orderId String @db.Uuid
 kind String
 createdAt DateTime @default(now())
 @@index([orderId])
}

model ProductImage {
 id String @id @default(uuid()) @db.Uuid
 data Bytes
 contentType String
 createdAt DateTime @default(now())
}

enum OutboxStatus {
 PENDING
 PUBLISHED
 PROCESSED
 DEAD
}
model OutboxEvent {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
 type String
 payload Json
 status OutboxStatus @default(PENDING)
 attempts Int @default(0)
 availableAt DateTime @default(now())
 lastPublishedAt DateTime?
 processedAt DateTime?
 lastError String?
 createdAt DateTime @default(now())
 @@index([status,availableAt,lastPublishedAt])
 @@index([orderId,createdAt])
}
model OrderWorkItem {
 orderId String @id @db.Uuid
 order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
 state String
 updatedAt DateTime @updatedAt
}

model StoreContent {
 id String @id
 content Json
 revision Int @default(0)
 updatedAt DateTime @updatedAt
}

model InboxKey {
 id String @id @db.Uuid
 publicJwk Json
 fingerprint String @unique @db.VarChar(64)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 messages SupportMessage[]
 conversations Conversation[]
}
enum SupportStatus {
 NEW
 READ
 RESOLVED
}
model SupportMessage {
 id String @id @db.Uuid
 keyId String @db.Uuid
 key InboxKey @relation(fields: [keyId], references: [id], onDelete: Restrict)
 envelope Json
 digest String @db.VarChar(64)
 status SupportStatus @default(NEW)
 createdAt DateTime @default(now())
 readAt DateTime?
 resolvedAt DateTime?
 @@index([status,createdAt,id])
 @@index([keyId])
}

model WishlistItem {
 userId String @db.Uuid
 productId String @db.Uuid
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 @@id([userId,productId])
 @@index([userId,createdAt,productId])
}

model CustomerInboxKey {
 backup Json?
 id String @id @db.Uuid
 userId String @unique @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 publicJwk Json
 fingerprint String @unique @db.VarChar(64)
 createdAt DateTime @default(now())
 conversations Conversation[]
}
model Conversation {
 id String @id @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 customerKeyId String @db.Uuid
 customerKey CustomerInboxKey @relation(fields:[customerKeyId],references:[id],onDelete:Restrict)
 adminKeyId String @db.Uuid
 adminKey InboxKey @relation(fields:[adminKeyId],references:[id],onDelete:Restrict)
 resolved Boolean @default(false)
 sequence Int @default(0)
 customerRead Int @default(0)
 adminRead Int @default(0)
 lastCustomerSequence Int @default(0)
 lastAdminSequence Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @default(now())
 messages ConversationMessage[]
 @@index([userId,updatedAt,id])
 @@index([updatedAt,id])
}
model ConversationMessage {
 id String @id @db.Uuid
 conversationId String @db.Uuid
 conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
 senderId String @db.Uuid
 fromAdmin Boolean
 sequence Int
 envelope Json
 digest String @db.VarChar(64)
 createdAt DateTime @default(now())
 @@unique([conversationId,sequence])
}
model Broadcast {
 id String @id @db.Uuid
 title String @db.VarChar(160)
 body String @db.VarChar(5000)
 kind String
 href String?
 imageUrl String?
 publishedAt DateTime?
 archivedAt DateTime?
 createdAt DateTime @default(now())
 receipts BroadcastReceipt[]
 @@index([publishedAt,id])
}
model BroadcastReceipt {
 userId String @db.Uuid
 broadcastId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 broadcast Broadcast @relation(fields:[broadcastId],references:[id],onDelete:Cascade)
 readAt DateTime @default(now())
 @@id([userId,broadcastId])
}
model CustomerPreferences {
 userId String @id @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 promotions Boolean @default(true)
 updatedAt DateTime @updatedAt
}
model SavedAddress {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 label String @db.VarChar(60)
 address Json
 digest String @db.VarChar(64)
 isDefault Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([userId,digest])
 @@index([userId,createdAt])
}
