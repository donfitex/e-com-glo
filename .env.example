NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ecom:local-development-only@localhost:5432/ecom?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Optional private local embedding service; unset for text-only discovery.
# SEMANTIC_SEARCH_URL=http://127.0.0.1:8000
# Checkout is unavailable until explicit country/currency rules are configured.
# These rules are merchant configuration, not an automatic tax-compliance service.
CHECKOUT_RULES_JSON=[]
STOREFRONT_ORIGIN=http://localhost:3001
# Stripe is deliberately limited to test-mode credentials in this release.
# STRIPE_SECRET_KEY=sk_test_configure_in_secret_manager
# STRIPE_WEBHOOK_SECRET=whsec_configure_in_secret_manager
