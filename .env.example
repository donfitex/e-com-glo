NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ecom:local-development-only@localhost:5432/ecom?schema=public
# Neon staging: direct URL for migrations; app uses pooled DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Optional private local embedding service; unset for text-only discovery.
# SEMANTIC_SEARCH_URL=http://127.0.0.1:8000
# Checkout is unavailable until explicit country/currency rules are configured.
# These rules are merchant configuration, not an automatic tax-compliance service.
CHECKOUT_RULES_JSON=[]
STOREFRONT_ORIGIN=http://localhost:3001
# Paystack uses the same secret for API requests and HMAC webhook verification.
PAYSTACK_CURRENCIES=NGN
# PAYSTACK_SECRET_KEY=sk_test_configure_in_secret_manager

# Catalog cache TTL; Redis failures fall back to authoritative database reads.
CACHE_TTL_SECONDS=3600

# Independent order-event worker polling interval (milliseconds).
WORKER_POLL_INTERVAL_MS=5000

# General API capacity; login remains separately capped at 5 attempts / 900 seconds.
API_RATE_LIMIT_PER_MINUTE=120

# Optional transactional password-reset email (verified Resend sender/domain).
# Configure these on BOTH API and independent worker. Never use NEXT_PUBLIC_ secrets.
# RESEND_API_KEY=re_configure_in_secret_manager
# EMAIL_FROM=E-com Global <accounts@your-verified-domain.example>
# STOREFRONT_ORIGIN must be the public HTTPS storefront for reset links.

# Optional stable secret for managed CUSTOMER message recovery.
# Set BEFORE the first recovery key is created; do not rotate without rewrapping its private box.
# If omitted, a purpose-specific key is derived from JWT_SECRET; preserve that secret.
# MESSAGE_RECOVERY_SECRET=configure-a-stable-random-secret-at-least-32-characters
